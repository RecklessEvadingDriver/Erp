# Runtime
NODE_ENV=production
PORT=5000

# CORS (comma separated origins)
CLIENT_URL=http://localhost:5000

# Security
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# MongoDB (docker-compose local)
MONGO_ROOT_USERNAME=erp_admin
MONGO_ROOT_PASSWORD=erp_password
MONGO_DB_NAME=erp
MONGO_PORT=27017
MONGO_URI=mongodb://erp_admin:erp_password@mongo:27017/erp?authSource=admin

# Optional Cloudinary (required only for upload endpoints)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
